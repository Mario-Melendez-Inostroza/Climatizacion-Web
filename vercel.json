{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "climatizacion-web.vercel.app" }],
      "destination": "https://www.solucionesintegralesmyn.cl/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "climatizacion-web.vercel.app" }],
      "destination": "https://www.solucionesintegralesmyn.cl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/gasfiteria", "destination": "/index.html" },
    { "source": "/climatizacion", "destination": "/index.html" },
    { "source": "/electricidad", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
